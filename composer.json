{
    "name": "dkbs/dkbsign-sdk-laravel",
    "description": "Laravel SDK for DKBSign self-sign",
    "keywords": [
        "dkbs",
        "DKBSign",
        "dkbsign-sdk-laravel",
        "laravel",
        "signature",
        "self-sign",
        "pdf"
    ],
    "homepage": "https://github.com/DKBSDEV-TEAM/dkbsign-sdk-laravel",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Grace Sokora ",
            "email": "grace.sokora@dkbsolutions.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Dkbs\\LaravelDKBSign\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dkbs\\LaravelDKBSign\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dkbs\\LaravelDKBSign\\DKBSignServiceProvider"
            ],
            "aliases": {
                "DKBSign": "Dkbs\\LaravelDKBSign\\Facades\\DKBSign"
            }
        }
    }
}
