{
    "name": "dkbs/dkbsign-sdk-laravel",
    "description": "",
    "keywords": [
        "dkbs",
        "dkbsign-sdk-laravel"
    ],
    "homepage": "https://github.com/dkbs/dkbsign-sdk-laravel",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Grace Sokora ",
            "email": "grace.sokora@dkbsolutions.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^7.4|^8.0",
        "illuminate/support": "^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0",
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Dkbs\\DkbsignSdkLaravel\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dkbs\\DkbsignSdkLaravel\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"

    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dkbs\\DkbsignSdkLaravel\\DkbsignSdkLaravelServiceProvider"
            ],
            "aliases": {
                "DkbsignSdkLaravel": "Dkbs\\DkbsignSdkLaravel\\DkbsignSdkLaravelFacade"
            }
        }
    }
}
